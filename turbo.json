{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "passThroughEnv": ["DATABASE_URL", "DEMO_PASSWORD", "SESSION_SECRET", "WEB_ORIGIN", "PORT"]
    }
  }
}
