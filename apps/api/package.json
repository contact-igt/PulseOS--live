{
  "name": "@pulseos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore '**/node_modules/**' --ignore '**/src/db/migrations/**' src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "staff:add": "tsx src/ops/add-staff.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@node-rs/argon2": "2.2.1",
    "@pulseos/types": "workspace:*",
    "@pulseos/validation": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "libphonenumber-js": "^1.13.13",
    "postgres": "3.4.9",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "3.2.4"
  }
}
