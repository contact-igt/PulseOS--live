DATABASE_URL=postgres://localhost:5432/pulseos_dev
PORT=4310
WEB_ORIGIN=http://localhost:3310
SESSION_SECRET=replace-with-a-long-random-local-dev-secret
DEMO_PASSWORD=replace-with-a-local-demo-password
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-local-dev-secret
# Dev Login (one-click sign-in as a seeded demo role, skips typing a
# password) — only takes effect when NODE_ENV is not "production" too; see
# auth.routes.ts::devLoginEnabled, and it only answers the loopback interface. Leave unset/false on any shared
# server, and never enable it behind a reverse proxy (the proxy's own address is loopback).
ENABLE_DEV_LOGIN=true

# The public https address of THIS API (no trailing slash). Shown to hospitals as the Website Leads intake address and used for
# provider callback URLs. Unset outside production = http://localhost:PORT; unset or malformed in production = no address is shown.
# PUBLIC_API_BASE_URL=https://your-api.example.com
# Number of reverse proxies in front of the API (1 behind a single proxy). Unset = trust nobody (request.ip is the socket peer),
# which keeps a forged X-Forwarded-For from changing a client's rate-limit identity. Set it correctly behind Railway or any proxy.
# TRUST_PROXY=1
# Website Leads intake: requests per client address per minute (default 20).
# FORM_INTAKE_MAX_PER_MINUTE=20
