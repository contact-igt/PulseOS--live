DATABASE_URL=postgres://localhost:5432/pulseos_dev
PORT=4310
WEB_ORIGIN=http://localhost:3310
SESSION_SECRET=replace-with-a-long-random-local-dev-secret
DEMO_PASSWORD=replace-with-a-local-demo-password
# REQUIRED wherever connector credentials are saved or read (CCS, Runo, WhatsApp, ads, webhooks), including production.
# Without it the API still starts but those operations fail (503 encryption_not_configured). Do NOT change it once credentials
# are stored: a different value makes every stored credential unreadable until each one is re-entered (see docs/deployment-railway.md).
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-local-dev-secret
# Dev Login (one-click sign-in as a seeded demo role, skips typing a
# password) — only takes effect when NODE_ENV is not "production" too; see
# auth.routes.ts::devLoginEnabled, and it only answers the loopback interface. Leave unset/false on any shared
# server, and never enable it behind a reverse proxy (the proxy's own address is loopback).
ENABLE_DEV_LOGIN=true
