{
  "name": "pulseos",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @pulseos/api db:migrate",
    "db:seed": "pnpm --filter @pulseos/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "fast-uri@>=4.0.0 <4.1.5": "4.1.5"
    }
  }
}
